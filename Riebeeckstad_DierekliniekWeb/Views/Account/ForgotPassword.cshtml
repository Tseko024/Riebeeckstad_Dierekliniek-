@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
    ViewData["BackUrl"] = Url.Action("Login", "Account");
}

<section class="auth">
    <div class="auth-header">
        <partial name="_Brand" />
    </div>

    <h1 class="auth-title">Forgot your password?</h1>
    <p class="auth-subtitle">Enter your email and we'll send you a link to set a new one.</p>

    <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="auth-form auth-form-narrow">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

        <div class="field">
            <label asp-for="Email" class="visually-hidden"></label>
            <div class="input-icon">
                <i class="bi bi-envelope-check-fill"></i>
                <input asp-for="Email" placeholder="Email Address" autocomplete="email" autofocus />
            </div>
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="text-end">
            <button type="submit" class="btn-pill btn-red btn-sm-pill">
                <i class="bi bi-envelope"></i>
                <span>Send link</span>
                <i class="bi bi-arrow-right-circle"></i>
            </button>
        </div>

        <p class="auth-switch">
            Remembered it? <a asp-controller="Account" asp-action="Login">Back to login</a>
        </p>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}