@using System.Security.Claims
@{
    var active = ViewData["Active"] as string ?? "";
    var name = User.FindFirstValue(ClaimTypes.Name) ?? "Staff";
    var role = User.FindFirstValue(ClaimTypes.Role) switch
    {
        "vet" => "Veterinarian",
        "receptionist" => "Receptionist",
        var r => r ?? "",
    };

    string Item(string key) => active == key ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Riebeeckstad Staff</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Gelasio:ital,wght@0,400;0,600;1,400&family=Kaushan+Script&family=Montserrat:ital,wght@0,500;0,600;0,700;0,800;1,700;1,800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/staff.css" asp-append-version="true" />
</head>
<body class="staff-body">
    <!-- Header: logo + user menu -->
    <header class="staff-header">
        <button class="menu-toggle" type="button" aria-label="Open menu" aria-controls="sidebar" aria-expanded="false">
            <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true">
                <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
            </svg>
        </button>
        <partial name="_Brand" />

        <div class="dropdown user-menu">
            <button class="user-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-person"></i>
                <span class="user-text">
                    <strong>@name</strong>
                    <small>@role</small>
                </span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i> Settings</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Log out</button>
                    </form>
                </li>
            </ul>
        </div>
    </header>

    <div class="staff-shell">
        <!-- Sidebar -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-inner">
                <nav class="sidebar-nav" aria-label="Staff">
                    <a class="@Item("Dashboard")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2"></i> Dashboard</a>
                    <a class="@Item("Appointments")" asp-controller="Appointments" asp-action="Index"><i class="bi bi-calendar-week"></i> Appointments</a>
                    <a class="@Item("Clients")" asp-controller="Clients" asp-action="Index"><i class="bi bi-people"></i> Clients/Pets</a>
                    <a class="@Item("Treatments")" asp-controller="Treatments" asp-action="Index"><i class="bi bi-clipboard2-pulse"></i> Treatment Records</a>
                    <a class="@Item("History")" asp-controller="History" asp-action="Index"><i class="bi bi-clock-history"></i> History</a>
                    <a class="@Item("Messages")" asp-controller="Messages" asp-action="Index"><i class="bi bi-chat-dots"></i> Messages</a>
                    <a class="@Item("Settings")" asp-controller="Settings" asp-action="Index"><i class="bi bi-gear"></i> Settings</a>
                </nav>

                <div class="sidebar-foot">
                    <div class="sidebar-motto">
                        <partial name="_Paw" model='"sidebar-paw"' />
                        <span>Healthy Pets<br />Happier Lives</span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        <button type="submit" class="sidebar-logout" aria-label="Log out" title="Log out">
                            <i class="bi bi-arrow-left-circle"></i>
                        </button>
                    </form>
                </div>
            </div>
        </aside>
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Page -->
        <main class="staff-content">
            @if (TempData["Success"] is string ok)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    <i class="bi bi-check-circle-fill"></i> @ok
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string err)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i> @err
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Mobile: open / close the sidebar
        (() => {
            const sidebar = document.getElementById('sidebar');
            const backdrop = document.getElementById('sidebarBackdrop');
            const toggle = document.querySelector('.menu-toggle');
            const set = open => {
                sidebar.classList.toggle('open', open);
                backdrop.classList.toggle('show', open);
                toggle.setAttribute('aria-expanded', open);
            };
            toggle.addEventListener('click', () => set(!sidebar.classList.contains('open')));
            backdrop.addEventListener('click', () => set(false));
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>