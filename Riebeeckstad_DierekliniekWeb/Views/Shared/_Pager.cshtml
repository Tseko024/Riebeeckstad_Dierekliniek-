@model Pager
@{
    // Show up to 5 page numbers around the current page
    var first = Math.Max(1, Model.Page - 2);
    var last = Math.Min(Model.PageCount, first + 4);
    first = Math.Max(1, last - 4);
}
<div class="pager-row">
    <span class="pager-info">
        @if (Model.Total == 0)
        {
            <text>No @Model.Noun</text>
        }
        else
        {
            <text>Showing @Model.From–@Model.To of @Model.Total @Model.Noun</text>
        }
    </span>
    @if (Model.PageCount > 1)
    {
        <nav aria-label="Pages">
            <ul class="pager">
                <li><a class="@(Model.Page <= 1 ? "disabled" : "")" href="@(Model.Page <= 1 ? "#" : Model.UrlFor(Model.Page - 1))" aria-label="Previous page"><i class="bi bi-chevron-left"></i></a></li>
                @for (var p = first; p <= last; p++)
                {
                    <li><a class="@(p == Model.Page ? "current" : "")" href="@Model.UrlFor(p)" aria-current="@(p == Model.Page ? "page" : null)">@p</a></li>
                }
                <li><a class="@(Model.Page >= Model.PageCount ? "disabled" : "")" href="@(Model.Page >= Model.PageCount ? "#" : Model.UrlFor(Model.Page + 1))" aria-label="Next page"><i class="bi bi-chevron-right"></i></a></li>
            </ul>
        </nav>
    }
</div>